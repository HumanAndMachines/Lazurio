{
  "name": "lazurio",
  "private": true,
  "type": "module",
  "workspaces": [
    "lazurio",
    "launchpad"
  ],
  "imports": {
    "#lazurio-core/resident-manifest": "./lazurio/core/resident-manifest-lib.mjs"
  },
  "scripts": {
    "check": "bun run terminology:test && bun run preservation:test && bun run personalspace:test && bun run worktrees:test && bun run runtime:migrate:test && bun run git-policy:test && bun run agent-skills:test && bun run integrations:contracts:test && bun run mission-control:smoke:test && bun run lazurio:test && bun run resident:test && bun run doctor:agent-skills && bun run --cwd launchpad check",
    "doctor": "bun run --cwd launchpad doctor",
    "doctor:task": "bun run --cwd launchpad doctor:task",
    "doctor:json": "bun run --cwd launchpad doctor:json",
    "update": "bun run --cwd launchpad update",
    "launchpad": "bun run --cwd launchpad launch",
    "launchpad:serve": "bun run --cwd launchpad serve",
    "launchpad:dev": "bun run --cwd launchpad dev",
    "lazurio": "bun lazurio/cli.mjs",
    "lazurio:test": "bun test --cwd lazurio --timeout 30000 ./lazurio.test.mjs ./module-setup-cli.test.mjs ./module-lifecycle-cli.test.mjs ./module-location-repair-cli.test.mjs ./search.test.mjs ./parity.test.mjs ./launchpad-install.test.mjs ./launchpad-serve.test.mjs ./cli-install.test.mjs ./install-output-lib.test.mjs ./organization-activation-cli.test.mjs ./organization-activation-lib.test.mjs ./organization-install-lib.test.mjs ./core/import-boundary.test.mjs ./core/cli-provenance-lib.test.mjs ./core/github-provider-lib.test.mjs ./core/github-builder-readiness-lib.test.mjs ./core/git-materialization-lib.test.mjs ./core/install-core-lib.test.mjs ./core/toolchain-lib.test.mjs ./core/tool-update-lib.test.mjs ./core/organization-activation-lib.test.mjs ./core/organization-root-reader-lib.test.mjs ./core/organization-scaffold-lib.test.mjs ./core/resident-manifest-lib.test.mjs ./core/module-contract-lib.test.mjs ./core/module-lifecycle-client-lib.test.mjs ./core/module-location-repair-contract-lib.test.mjs ./core/organization-port-policy-lib.test.mjs ./core/server-identity-lib.test.mjs ./core/task-agent-locator.test.mjs ./core/server-locator-lib.test.mjs ./organization-host/contract.test.mjs",
    "resident:build": "bun distribution/build.mjs",
    "workspace-runtime:build": "bun distribution/build.mjs --profile workspace",
    "resident:test": "bun test --timeout 60000 ./distribution/build.test.mjs ./distribution/npm-package.test.mjs ./distribution/updater.test.mjs ./distribution/buddy-service.test.mjs ./distribution/buddy-rollout.test.mjs ./provisioning/ansible-contract.test.mjs ./tests/bridge",
    "npm-package:gate": "bun distribution/npm-package-gate.mjs",
    "resident:operator:test": "bun test ./provisioning/ansible-contract.test.mjs",
    "resident:install": "bun distribution/runtime/updater.mjs install",
    "resident:update": "bun distribution/runtime/updater.mjs update",
    "resident:rollback": "bun distribution/runtime/updater.mjs rollback",
    "resident:status": "bun distribution/runtime/updater.mjs status",
    "resident:buddy-service": "bun distribution/runtime/buddy-service.mjs",
    "resident:buddy-rollout": "bun distribution/runtime/buddy-rollout.mjs",
    "personalspace:create": "bun scripts/create-personalspace.mjs",
    "personalspace:test": "bun test ./scripts/create-personalspace.test.mjs",
    "pr:preflight": "bun scripts/pr-preflight.mjs",
    "doctor:agent-skills": "bun scripts/agent-skills-entrypoint.mjs check",
    "repair:agent-skills": "bun scripts/agent-skills-entrypoint.mjs repair",
    "agent-skills:test": "bun test ./scripts/agent-skills-entrypoint.test.mjs ./scripts/agent-builder-validator.test.mjs",
    "integrations:contracts:test": "bun test ./scripts/external-app-integrations-contract.test.mjs",
    "mission-control:smoke": "bun scripts/mission-control-trust-smoke.mjs",
    "mission-control:smoke:test": "bun test ./scripts/mission-control-trust-smoke.test.mjs",
    "git-policy:test": "bun test ./scripts/pr-preflight.test.mjs ./launchpad/src/task-preflight-lib.test.mjs",
    "check:strict": "bun run terminology:test && bun run preservation:test && bun run personalspace:test && bun run worktrees:test && bun run --cwd launchpad check:strict",
    "install:macos-app": "/bin/bash scripts/install-launchpad-macos.sh",
    "install:windows-shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Install-LaunchpadShortcut.ps1",
    "sync:gen2-gen3:inventory": "bun scripts/gen2-gen3-sync-inventory.mjs",
    "preserve:gen2-local": "node scripts/gen2-local-preservation.mjs",
    "preservation:test": "bun test ./scripts/gen2-gen3-sync-inventory.test.mjs ./scripts/gen2-local-preservation.test.mjs",
    "worktrees:create": "bun scripts/worktree-create.mjs",
    "worktrees:status": "bun .agents/skills/worktree-development-discipline/scripts/worktree-inventory.mjs",
    "worktrees:check": "bun .agents/skills/worktree-development-discipline/scripts/worktree-inventory.mjs --check",
    "runtime:migrate": "bun scripts/lazurio-runtime-migrate.mjs",
    "runtime:inventory": "bun scripts/lazurio-module-inventory.mjs",
    "runtime:migrate:test": "bun test ./scripts/lazurio-runtime-migrate.test.mjs ./scripts/lazurio-module-port.test.mjs ./scripts/lazurio-module-inventory.test.mjs",
    "worktrees:test": "bun test ./scripts/repository-db-authority-contract.test.mjs ./scripts/worktree-inventory.contract.test.mjs ./scripts/worktree-create-contract.test.mjs ./scripts/worktree-create.test.mjs ./scripts/worktree-create-git-policy.test.mjs ./scripts/worktree-create-lock.test.mjs",
    "terminology:test": "bun test ./scripts/task-agent-terminology.test.mjs ./scripts/public-example-boundary.test.mjs ./scripts/organization-manifest-consumers.test.mjs"
  }
}
