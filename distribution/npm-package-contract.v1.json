{
  "schema_version": "lazurio.cli.npm-package-contract.v1",
  "package_name": "lazurio",
  "source_repository": "HumanAndMachines/Lazurio",
  "packer": {
    "name": "npm",
    "version": "11.17.0"
  },
  "minimum_bun_version": "1.3.14",
  "source_includes": [
    "LICENSE.md",
    "README.md",
    "lazurio/README.md",
    "lazurio/cli.mjs",
    "lazurio/cli-install-lib.mjs",
    "lazurio/cli-provenance.v1.schema.json",
    "lazurio/context-v0.schema.json",
    "lazurio/core/",
    "lazurio/install-output-lib.mjs",
    "lazurio/install-report.v0.schema.json",
    "lazurio/launchpad-install-lib.mjs",
    "lazurio/lib.mjs",
    "lazurio/locales/",
    "lazurio/module-port-lib.mjs",
    "lazurio/module-lifecycle-report.v1.schema.json",
    "lazurio/module-setup-lib.mjs",
    "lazurio/module-setup-report.v1.schema.json",
    "lazurio/organization-activation-lib.mjs",
    "lazurio/organization-activation-report.v0.schema.json",
    "lazurio/search-lib.mjs",
    "lazurio/search-scopes.v1.json",
    "launchpad/schemas/",
    "launchpad/src/",
    "manual/module-setup.md",
    "manual/module-lifecycle.md"
  ],
  "source_excludes": {
    "basenames": [
      ".DS_Store"
    ],
    "suffixes": [
      ".test.js",
      ".test.mjs",
      ".test.ts"
    ],
    "exact_paths": [
      "launchpad/src/run-tests.mjs",
      "launchpad/src/test-platform-setup.mjs"
    ]
  },
  "required_paths": [
    "LICENSE.md",
    "README.md",
    "lazurio/cli.mjs",
    "lazurio/context-v0.schema.json",
    "lazurio/install-report.v0.schema.json",
    "lazurio/module-port-lib.mjs",
    "lazurio/module-lifecycle-report.v1.schema.json",
    "lazurio/module-setup-lib.mjs",
    "lazurio/module-setup-report.v1.schema.json",
    "lazurio/organization-activation-lib.mjs",
    "lazurio/organization-activation-report.v0.schema.json",
    "lazurio/search-scopes.v1.json",
    "launchpad/schemas/doctor-report.schema.json",
    "launchpad/schemas/personal.gen3.schema.json",
    "launchpad/src/lazurio-update-runtime.mjs",
    "manual/module-setup.md",
    "manual/module-lifecycle.md"
  ],
  "forbidden_path_segments": [
    ".git",
    ".worktrees",
    "node_modules",
    ".cache",
    "drafts",
    "private",
    "secrets",
    "logs",
    "testdata"
  ]
}
