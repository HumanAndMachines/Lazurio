{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.ai/schemas/organization-install-report.v0.schema.json",
  "title": "Lazurio Organization install report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "ok", "root", "organization", "access", "scope", "target", "convergence"],
  "properties": {
    "schema_version": { "const": "lazurio.organization.install.v0" },
    "state": { "enum": ["current", "updated", "blocked"] },
    "ok": { "type": "boolean" },
    "root": { "type": "string", "minLength": 1 },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "id", "login", "repository_id", "repository"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "login": { "type": ["string", "null"] },
        "repository_id": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "role", "status", "account", "repositories", "blockers"],
      "properties": {
        "authority": { "const": "github" },
        "role": { "enum": [null, "builder", "steward"] },
        "status": { "enum": ["not_requested", "ready", "blocked"] },
        "account": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "login"],
              "properties": {
                "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
                "login": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["full_name", "repository_id", "effective_permission"],
            "properties": {
              "full_name": { "type": "string", "minLength": 3 },
              "repository_id": { "type": ["string", "null"] },
              "effective_permission": { "enum": ["none", "read", "triage", "write", "maintain", "admin", "unknown", "unavailable"] }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "repository", "message"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "repository": { "type": ["string", "null"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "scope": {
      "description": "Materializační scope instalace. role null je explicitní Admin instalace a jako jediná zahrnuje (include) i absentní restricted sloty; role-scoped instalace je vyloučí (exclude) bez provider operace a označí je excluded_by_role_scope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "restricted_slots"],
      "properties": {
        "role": { "enum": [null, "builder", "steward"] },
        "restricted_slots": { "enum": ["include", "exclude"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "path", "message"],
      "properties": {
        "state": { "enum": ["current", "updated", "blocked"] },
        "reason": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": ["string", "null"] }
      }
    },
    "convergence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["schema_version", "state", "ok"],
          "properties": {
            "schema_version": { "const": "lazurio.update.v1" },
            "state": { "enum": ["current", "updated", "blocked"] },
            "ok": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
