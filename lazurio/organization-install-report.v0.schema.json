{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.ai/schemas/organization-install-report.v0.schema.json",
  "title": "Lazurio Organization install report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state", "ok", "root", "organization", "access", "target", "convergence"],
  "properties": {
    "schema_version": { "const": "lazurio.organization.install.v0" },
    "state": { "enum": ["current", "updated", "blocked"] },
    "ok": { "type": "boolean" },
    "root": { "type": "string", "minLength": 1 },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "id", "login", "repository_id", "repository"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "id": { "type": ["string", "null"] },
        "login": { "type": ["string", "null"] },
        "repository_id": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "role", "status", "account", "organization_membership", "teams", "repositories", "blockers"],
      "properties": {
        "authority": { "const": "github" },
        "role": { "enum": [null, "builder"] },
        "status": { "enum": ["not_requested", "ready", "blocked"] },
        "account": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "login"],
              "properties": {
                "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
                "login": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "organization_membership": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "role"],
              "properties": {
                "state": { "enum": ["active", "missing", "unavailable"] },
                "role": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["internal_slug", "github_team_id", "github_team_slug", "identity", "membership"],
            "properties": {
              "internal_slug": { "type": "string", "minLength": 1 },
              "github_team_id": { "type": ["string", "null"] },
              "github_team_slug": { "type": ["string", "null"] },
              "identity": { "enum": ["verified", "mismatch", "unavailable", "not_evaluated"] },
              "membership": { "enum": ["active", "missing", "unavailable", "not_evaluated"] }
            }
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["full_name", "repository_id", "effective_permission", "team_grants"],
            "properties": {
              "full_name": { "type": "string", "minLength": 3 },
              "repository_id": { "type": ["string", "null"] },
              "effective_permission": { "enum": ["none", "read", "triage", "write", "maintain", "admin", "unknown", "unavailable"] },
              "team_grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["internal_team_slug", "github_team_slug", "permission"],
                  "properties": {
                    "internal_team_slug": { "type": "string", "minLength": 1 },
                    "github_team_slug": { "type": ["string", "null"] },
                    "permission": { "enum": ["none", "read", "triage", "write", "maintain", "admin", "unavailable", "not_evaluated"] }
                  }
                }
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reason", "team", "repository", "message"],
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "team": { "type": ["string", "null"] },
              "repository": { "type": ["string", "null"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "path", "message"],
      "properties": {
        "state": { "enum": ["current", "updated", "blocked"] },
        "reason": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": ["string", "null"] }
      }
    },
    "convergence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["schema_version", "state", "ok"],
          "properties": {
            "schema_version": { "const": "lazurio.update.v1" },
            "state": { "enum": ["current", "updated", "blocked"] },
            "ok": { "type": "boolean" }
          }
        }
      ]
    }
  }
}
