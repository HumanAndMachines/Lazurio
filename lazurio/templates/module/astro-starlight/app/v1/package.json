{
  "name": "{{slug}}-app-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@{{bun_version}}",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prepare:app": "astro sync",
    "check:prepared": "bun run src/prepared.ts",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "astro check && biome check .",
    "test": "bun test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.37.7",
    "@lazurio/module-kit": "github:Lazurio/module-kit#v{{module_kit_version}}",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "{{runtime_id}}",
      "title": "{{display_name}}",
      "company": "{{organization}}",
      "module": "{{slug}}",
      "surface": "internal",
      "dev_script": "dev",
      "build_script": "build",
      "tags": [
        "{{slug}}",
        "docs"
      ],
      "listeners": [
        {
          "id": "{{listener_id}}",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v1/package.json",
      "prepare_script": "prepare:app",
      "check_script": "check:prepared"
    }
  }
}
