{
  "name": "{{slug}}-app-v1",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@{{bun_version}}",
  "scripts": {
    "dev": "uv run --no-sync {{slug}}",
    "check:prepared": "uv sync --frozen --check",
    "check": "uv run --frozen ruff format --check . && uv run --frozen ruff check . && uv run --frozen pyright",
    "test": "uv run --frozen pytest -q"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "{{runtime_id}}",
      "title": "{{display_name}}",
      "company": "{{organization}}",
      "module": "{{slug}}",
      "surface": "internal",
      "dev_script": "dev",
      "tags": [
        "{{slug}}"
      ],
      "listeners": [
        {
          "id": "{{listener_id}}",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/healthz"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "runtime": "uv",
      "uv_version": "{{uv_version}}",
      "owner_package": "app/v1/package.json",
      "check_script": "check:prepared"
    }
  }
}
