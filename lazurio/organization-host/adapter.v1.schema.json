{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazurio.organization_host.adapter.v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "profile_state",
    "topology",
    "runtime_pins",
    "health_checks",
    "logging",
    "recovery",
    "adapter",
    "custody"
  ],
  "properties": {
    "schema_version": {
      "const": "lazurio.organization_host.adapter.v1"
    },
    "contract_version": {
      "const": 1
    },
    "profile_state": {
      "enum": ["legacy", "target", "declared"]
    },
    "topology": {
      "type": "object",
      "required": [
        "host_kind",
        "workspace_isolation",
        "workspace_privilege",
        "workspace_purpose"
      ],
      "properties": {
        "host_kind": {
          "const": "organization-host"
        },
        "workspace_isolation": {
          "const": "per-team-runtime"
        },
        "workspace_privilege": {
          "const": "non-root"
        },
        "workspace_purpose": {
          "const": "private-development-only"
        }
      },
      "additionalProperties": false
    },
    "runtime_pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/runtime_pin"
      }
    },
    "health_checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": ["host", "workspace", "access", "runtime", "ingress", "storage"]
      }
    },
    "logging": {
      "type": "object",
      "required": ["content", "secrets", "retention"],
      "properties": {
        "content": {
          "const": "metadata-only"
        },
        "secrets": {
          "const": "forbidden"
        },
        "retention": {
          "const": "organization-owned"
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": [
        "checkpoint_before_mutation",
        "restore_readback",
        "clean_rebuild",
        "rollback"
      ],
      "properties": {
        "checkpoint_before_mutation": {
          "const": "required"
        },
        "restore_readback": {
          "const": "required"
        },
        "clean_rebuild": {
          "const": "required"
        },
        "rollback": {
          "const": "required"
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": ["interface_version", "transport", "entrypoint", "operations"],
      "properties": {
        "interface_version": {
          "const": 1
        },
        "transport": {
          "const": "stdio-json"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)*$"
        },
        "operations": {
          "type": "object",
          "required": ["validate", "readback"],
          "properties": {
            "validate": {
              "$ref": "#/definitions/read_only_operation"
            },
            "readback": {
              "$ref": "#/definitions/read_only_operation"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "custody": {
      "type": "object",
      "required": ["desired_state", "secrets", "provider_state", "deploy_audit"],
      "properties": {
        "desired_state": {
          "const": "organization-infra-repository"
        },
        "secrets": {
          "const": "organization-local-references-only"
        },
        "provider_state": {
          "const": "organization-owned"
        },
        "deploy_audit": {
          "const": "organization-infra-repository"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "runtime_pin": {
      "type": "object",
      "required": ["component", "kind", "value"],
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "enum": ["git-commit", "oci-digest", "package-version"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@:/-]*$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "git-commit"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9a-f]{40,64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "oci-digest"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "package-version"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
              }
            }
          }
        }
      ]
    },
    "read_only_operation": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "read-only"
        }
      },
      "additionalProperties": false
    }
  }
}
