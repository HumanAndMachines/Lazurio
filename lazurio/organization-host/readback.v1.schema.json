{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazurio.organization_host.readback.v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "observed_at",
    "profile_state",
    "runtime_pins",
    "health",
    "recovery",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "lazurio.organization_host.readback.v1"
    },
    "contract_version": {
      "const": 1
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "profile_state": {
      "enum": ["legacy", "target", "declared"]
    },
    "runtime_pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "kind", "observation", "declared", "observed"],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": ["git-commit", "oci-digest", "package-version"]
          },
          "observation": {
            "enum": ["observed", "missing", "not-evaluated"]
          },
          "declared": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@:/-]*$"
          },
          "observed": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@:/-]*$"
              },
              {
                "enum": [null]
              }
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "observation": {
                  "const": "observed"
                }
              }
            },
            "then": {
              "properties": {
                "observed": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@:/-]*$"
                }
              }
            },
            "else": {
              "properties": {
                "observed": {
                  "enum": [null]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "git-commit"
                }
              }
            },
            "then": {
              "properties": {
                "declared": {
                  "pattern": "^[0-9a-f]{40,64}$"
                },
                "observed": {
                  "anyOf": [
                    {
                      "pattern": "^[0-9a-f]{40,64}$"
                    },
                    {
                      "enum": [null]
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "oci-digest"
                }
              }
            },
            "then": {
              "properties": {
                "declared": {
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "observed": {
                  "anyOf": [
                    {
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    {
                      "enum": [null]
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "package-version"
                }
              }
            },
            "then": {
              "properties": {
                "declared": {
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
                },
                "observed": {
                  "anyOf": [
                    {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
                    },
                    {
                      "enum": [null]
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "health": {
      "type": "object",
      "required": ["overall", "checks"],
      "properties": {
        "overall": {
          "enum": ["pass", "warn", "fail", "not-evaluated"]
        },
        "checks": {
          "type": "object",
          "required": ["host", "workspace", "access", "runtime", "ingress", "storage"],
          "properties": {
            "host": {
              "$ref": "#/definitions/health_status"
            },
            "workspace": {
              "$ref": "#/definitions/health_status"
            },
            "access": {
              "$ref": "#/definitions/health_status"
            },
            "runtime": {
              "$ref": "#/definitions/health_status"
            },
            "ingress": {
              "$ref": "#/definitions/health_status"
            },
            "storage": {
              "$ref": "#/definitions/health_status"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["checkpoint", "restore", "clean_rebuild", "rollback"],
      "properties": {
        "checkpoint": {
          "enum": ["verified", "missing", "not-evaluated"]
        },
        "restore": {
          "enum": ["verified", "stale", "missing", "not-evaluated"]
        },
        "clean_rebuild": {
          "enum": ["verified", "missing", "not-evaluated"]
        },
        "rollback": {
          "enum": ["verified", "missing", "not-evaluated"]
        }
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "object",
      "required": ["owner", "operation", "reason_code"],
      "properties": {
        "owner": {
          "const": "organization-infra-repository"
        },
        "operation": {
          "anyOf": [
            {
              "enum": ["validate", "readback"]
            },
            {
              "enum": [null]
            }
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "health_status": {
      "enum": ["pass", "warn", "fail", "not-evaluated"]
    }
  }
}
