  "additionalProperties": true,
  "description": "Definice Organizace GEN3: jedna firma = jedno super-repo = jedna GitHub organizace = jedna access hranice (decision 0012/0015). V Launchpad rootu Conglomerate se mountuje jako organizations/<root_repo>/, kde <root_repo> je basename z company.root_repository. Uvnitř Organizace žijí Teamy (skupiny modulů — stejný pojem jako GitHub Team, dříve Workspaces/Oddělení, decisions 0021/0023; founder 2026-07-11), plochá pracovní složka workspace/, org-level productionspace a moduly.",
  "allOf": [
    {
      "if": {
        "required": [
          "organization_kind"
        ],
        "properties": {
          "organization_kind": {
            "const": "template"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "template_sync_role"
              ]
            },
            {
              "required": [
                "template_sync_authorization"
              ]
            }
          ]
        }
      },
      "else": {
        "properties": {
          "company": {
            "dependentRequired": {
              "repository": [
                "root_repository"
              ],
              "root_repository": [
                "repository"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "template_sync_role"
        ],
        "properties": {
          "template_sync_role": {
            "const": "source"
          }
        }
      },
      "then": {
        "required": [
          "template_sync_authorization"
        ],
        "properties": {
          "company": {
            "properties": {
              "slug": {
                "const": "Spectoda"
              },
              "github_org": {
                "pattern": "^[Ss][Pp][Ee][Cc][Tt][Oo][Dd][Aa]$"
              },
              "root_repository": {
                "pattern": "^[Ss][Pp][Ee][Cc][Tt][Oo][Dd][Aa]/Spectoda_GEN3$"
              }
            },
            "required": [
              "root_repository",
              "repository"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "template_sync_authorization"
          ]
        }
      }
    }
  ],
  "anyOf": [
    {
