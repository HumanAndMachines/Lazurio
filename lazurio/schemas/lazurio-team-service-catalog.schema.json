{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.dev/schemas/lazurio-team-service-catalog.schema.json",
  "title": "Lazurio Team service catalog",
  "anyOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "moduleLeaseKey": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "externalOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:(?=[a-z0-9.-]*[a-z])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*|(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])(?:\\.(?:0|[1-9][0-9]?|1[0-9]{2}|2[0-4][0-9]|25[0-5])){3})(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/$",
      "not": {
        "pattern": "^https://(?:localhost|(?:[^./]+\\.)+localhost|127(?:\\.[0-9]{1,3}){3})(?::[0-9]{1,5})?/$"
      }
    },
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "team_id", "generated_at", "services"],
      "properties": {
        "schema_version": { "const": "lazurio.team_service_catalog.v1" },
        "team_id": { "$ref": "#/$defs/identity" },
        "generated_at": { "type": "string", "format": "date-time" },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["app_id", "module_lease_key", "external_origin"],
            "properties": {
              "app_id": { "$ref": "#/$defs/appId" },
              "module_lease_key": { "$ref": "#/$defs/moduleLeaseKey" },
              "external_origin": { "$ref": "#/$defs/externalOrigin" }
            }
          }
        }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "organization_slug",
        "team_id",
        "catalog_revision",
        "generated_at",
        "services"
      ],
      "properties": {
        "schema_version": { "const": "lazurio.team_service_catalog.v2" },
        "organization_slug": { "$ref": "#/$defs/identity" },
        "team_id": { "$ref": "#/$defs/identity" },
        "catalog_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generated_at": { "type": "string", "format": "date-time" },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["app_id", "module_lease_key", "external_origin", "source"],
            "properties": {
              "app_id": { "$ref": "#/$defs/appId" },
              "module_lease_key": { "$ref": "#/$defs/moduleLeaseKey" },
              "external_origin": { "$ref": "#/$defs/externalOrigin" },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type"],
                    "properties": { "type": { "const": "main" } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "slug", "mission_control_plan_code", "branch"],
                    "properties": {
                      "type": { "const": "worktree" },
                      "slug": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._-]+$"
                      },
                      "mission_control_plan_code": {
                        "type": "string",
                        "pattern": "^[A-Z]+-[0-9]+$"
                      },
                      "branch": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "pattern": "^(?![/.])(?!.*(?:\\.\\.|//|@\\{|\\\\))[A-Za-z0-9._/-]*[A-Za-z0-9_-]$"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
