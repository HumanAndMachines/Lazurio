{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.ai/schemas/lazurio-runtime.v1.json",
  "title": "Lazurio runnable package runtime contract",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "company",
    "module",
    "surface",
    "dev_script",
    "tags",
    "listeners"
  ],
  "properties": {
    "schema_version": { "const": "lazurio.runtime.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "company": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$" },
    "module": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "surface": { "enum": ["internal", "manual", "admin", "public-preview"] },
    "dev_script": { "type": "string", "minLength": 1 },
    "preview_script": { "type": "string", "minLength": 1 },
    "build_script": { "type": "string", "minLength": 1 },
    "build_output": {
      "description": "Adresář statického výstupu sestavení v balíčku App (Module Standard 4.5, rozhodnutí 0195 bod 19). Platforma ho po sestavení z main servíruje sama.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
    },
    "static_fallback": {
      "description": "Co dostane neznámá cesta: 404 = 404.html sestavení se stavem 404, spa = index.html. Jen spolu s build_output.",
      "enum": ["404", "spa"]
    },
    "required_module_slots": {
      "description": "Organization-relative module sloty, které musí být materializované před spuštěním runtime.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
      }
    },
    "secrets": {
      "description": "Jména tajemství, která App potřebuje ke startu (decision 0177). Jen jména, nikdy hodnoty; Launchpad je předá z trezoru Environmentu jako LAZURIO_RUNTIME_SECRET_<NAME>.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "optional_secrets": {
      "description": "Volitelná tajemství: nepřítomná hodnota vypne příslušnou capability, ne celou App. Jen jména, nikdy hodnoty; jméno nesmí být zároveň v secrets (kontroluje Core).",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "plugin": { "type": "string", "minLength": 1, "pattern": "\\.json$" },
    "icon": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "group": { "type": "string", "minLength": 1, "maxLength": 80 },
    "production_url": { "type": "string", "pattern": "^https?://" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "listeners": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": { "role": { "const": "entrypoint" } },
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": { "$ref": "#/$defs/listener" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "listener": {
      "type": "object",
        "required": ["id", "role", "lease", "protocol", "health"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "role": { "enum": ["entrypoint", "auxiliary"] },
          "lease": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "protocol": { "enum": ["http", "https", "tcp"] },
          "health": { "$ref": "#/$defs/health" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "entrypoint" } },
            "required": ["role"]
          },
          "then": { "properties": { "protocol": { "enum": ["http", "https"] } } }
        },
        {
          "if": {
            "properties": {
              "health": {
                "properties": { "kind": { "const": "http" } },
                "required": ["kind"]
              }
            }
          },
          "then": { "properties": { "protocol": { "enum": ["http", "https"] } } }
        }
      ],
      "additionalProperties": false
    },
    "health": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "http" },
            "path": { "type": "string", "pattern": "^/" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "tcp" } },
          "additionalProperties": false
        }
      ]
    }
  }
}
