{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.local/schema/lazurio.organization.v1.schema.json",
  "title": "Lazurio Organization manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "organization",
    "manifests",
    "extensions",
    "compatibility"
  ],
  "properties": {
    "schema_version": { "const": "lazurio.organization.v1" },
    "kind": { "enum": ["organization", "template"] },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name", "forge_binding", "metadata"],
      "properties": {
        "slug": { "type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S.*\\S)$" },
        "display_name": { "type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S.*\\S)$" },
        "forge_binding": { "$ref": "#/$defs/organizationForgeBinding" },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": ["slug", "display_name", "github_org", "repository", "git_url", "root_repository", "default_branch"]
            }
          }
        }
      }
    },
    "root_repository": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/repositoryForgeBinding" }
      ]
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules"],
      "properties": {
        "modules": { "const": "modules.manifest.json" }
      }
    },
    "module_port_pool": {
      "type": "object",
      "$comment": "Core additionally requires start <= end; standard JSON Schema cannot express this cross-field comparison without a non-portable extension.",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "end": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "default_branch": { "const": "main" },
        "access_authority": { "const": "github" }
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "display_name"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "display_name": { "type": "string", "minLength": 1 },
          "default": { "type": "boolean" },
          "description": { "type": "string" },
          "forge_binding": { "$ref": "#/$defs/teamForgeBinding" }
        }
      }
    },
    "layers": { "type": "array" },
    "task_sources": { "type": "array" },
    "doctor": { "type": "object" },
    "settings": { "$ref": "#/$defs/organizationSettings" },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy"],
      "properties": {
        "legacy": {
          "type": "object",
          "description": "Losslessly preserved Organization-owned legacy fields without canonical-field collisions.",
          "propertyNames": {
            "not": {
              "enum": ["organization_generation", "organization_kind", "company", "forge_binding", "governance", "teams", "layers", "task_sources", "doctor", "module_port_pool", "modules", "default_branch"]
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy_projection"],
      "properties": {
        "legacy_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "algorithm", "sha256"],
          "properties": {
            "path": { "const": "company.gen3.json" },
            "algorithm": { "const": "sha256-canonical-json-v1" },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    }
  },
  "$defs": {
    "organizationSettings": {
      "description": "Organization settings (decision 0194). An absent value is not governed by the Organization and each Environment decides; a present value governs every work Environment of the Organization; personal Environments ignore Organization settings. Excluded from the legacy compatibility projection and the semantic hash. Lazurio Core validates the same closed tree (core/organization-settings-lib.mjs).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "integrations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "composio": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowed"],
              "properties": {
                "allowed": {
                  "type": "boolean",
                  "description": "Whether Integrations may be connected through Composio on the Organization's work Environments (decision 0162, addendum 2026-10-09)."
                }
              }
            },
            "microsoft365": {
              "description": "The Organization's Microsoft 365 company app (decision 0162, addendum 2026-10-14): one single-tenant Entra app in the Organization's own tenant, a public client with admin consent. Only identifiers that are not secrets; the closed object refuses any other key, so no secret can be declared here.",
              "type": "object",
              "additionalProperties": false,
              "required": ["tenant_id", "client_id", "apps", "callbacks"],
              "properties": {
                "tenant_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "Directory (tenant) id of the Organization's Microsoft tenant, lowercase GUID."
                },
                "client_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "Application (client) id of the Organization's Entra app, lowercase GUID."
                },
                "apps": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["outlook", "one_drive", "share_point"] },
                  "description": "Parts of the company app a connected account gets as one Integration, and so its delegated scopes: outlook (mail and calendar), one_drive, share_point."
                },
                "callbacks": {
                  "type": "array",
                  "maxItems": 255,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^https://launchpad\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\.lazurio\\.io/api/integrations/oauth/callback$"
                  },
                  "description": "Hosted Launchpad callbacks (https://launchpad.<machine>.<github-org-login>.lazurio.io/api/integrations/oauth/callback) registered as redirect URIs of the Entra app, at most 255 because Entra allows 256 and the localhost callback takes one. An Environment whose callback is listed signs in from the user's own browser; any other one uses Executor's redirect URI http://localhost/api/oauth/callback, which is always registered and never listed, in the Environment browser."
                }
              }
            },
            "chatgpt_apps": {
              "type": "object",
              "additionalProperties": false,
              "required": ["allowed"],
              "properties": {
                "allowed": {
                  "type": "boolean",
                  "description": "Whether agents in the Organization's work and Team Environments may use the apps, plugins and connectors of the person's ChatGPT account for apps that Integrations do not have (decision 0162, addendum 2026-10-27). Absent means off on every Environment, unlike composio."
                }
              }
            }
          }
        },
        "access_requests": {
          "description": "Access requests (decision 0204, addendum 2026-10-17 afternoon, point b): a setting of the Lazurio Dashboard alone. No Environment receives, applies or reports it.",
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether a signed-in Lazurio account without membership may ask the Organization for access through its join link on the Dashboard. Absent or false is off."
            }
          }
        }
      }
    },
    "bindingState": { "enum": ["unverified", "verified"] },
    "organizationForgeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forge", "locator", "binding_state"],
      "properties": {
        "forge": { "const": "github" },
        "locator": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "binding_state": { "$ref": "#/$defs/bindingState" },
        "organization_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "binding_state": { "const": "verified" } } },
          "then": { "required": ["organization_id"] },
          "else": { "not": { "required": ["organization_id"] } }
        }
      ]
    },
    "repositoryForgeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forge", "locator", "default_branch", "binding_state"],
      "properties": {
        "forge": { "const": "github" },
        "locator": { "type": "string", "minLength": 3, "pattern": "^(?!.*\\.git$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "default_branch": { "const": "main" },
        "binding_state": { "$ref": "#/$defs/bindingState" },
        "repository_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "binding_state": { "const": "verified" } } },
          "then": { "required": ["repository_id"] },
          "else": { "not": { "required": ["repository_id"] } }
        }
      ]
    },
    "teamForgeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "provider", "team"],
      "properties": {
        "schema_version": { "const": "lazurio.team-forge-binding.github.v0" },
        "provider": { "const": "github" },
        "team": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "asserted_slug"],
          "properties": {
            "id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
            "asserted_slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$" }
          }
        }
      }
    }
  }
}
