{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazurio.ai/schemas/module-setup-report.v1.json",
  "title": "Lazurio Module setup report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "reason",
    "root",
    "module",
    "changes",
    "runtime",
    "issues",
    "operator_assertions"
  ],
  "properties": {
    "schema_version": { "const": "lazurio.module_setup.report.v1" },
    "status": { "enum": ["current", "actionable", "completed", "action_required"] },
    "reason": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "module": {
      "type": "object",
      "required": ["company", "id", "root", "manifest"],
      "properties": {
        "company": { "type": ["string", "null"] },
        "id": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "path"],
        "properties": {
          "action": { "enum": ["create", "replace"] },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": ["object", "null"],
      "required": ["tcp_port_policy", "default_app", "apps"],
      "properties": {
        "tcp_port_policy": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["none", "single", "exception"] },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "default_app": { "type": ["string", "null"] },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "package",
              "id",
              "title",
              "surface",
              "dev_script",
              "default",
              "tags",
              "listeners"
            ],
            "properties": {
              "package": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "surface": { "type": "string", "minLength": 1 },
              "dev_script": { "type": "string", "minLength": 1 },
              "preview_script": { "type": "string", "minLength": 1 },
              "build_script": { "type": "string", "minLength": 1 },
              "required_module_slots": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "plugin": { "type": "string", "minLength": 1 },
              "icon": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "group": { "type": "string", "minLength": 1 },
              "production_url": { "type": "string", "minLength": 1 },
              "default": { "type": "boolean" },
              "tags": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "listeners": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "role",
                    "lease",
                    "protocol",
                    "host",
                    "port",
                    "health",
                    "host_env",
                    "port_env"
                  ],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "role": { "enum": ["entrypoint", "auxiliary"] },
                    "lease": { "type": "string", "minLength": 1 },
                    "protocol": { "enum": ["http", "https", "tcp"] },
                    "host": { "type": "string", "minLength": 1 },
                    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
                    "health": {
                      "type": "object",
                      "required": ["kind"],
                      "properties": {
                        "kind": { "enum": ["http", "tcp"] },
                        "path": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    },
                    "host_env": { "type": "string", "minLength": 1 },
                    "port_env": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "action"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "operator_assertions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "standard": {
      "description": "Lazurio Module Standard conformance (manual/module-standard.md kap. 11, decision 0171). Additive: older producers omit it; null when the Module contract itself is blocked. `current` means every check is `pass`; `warn` marks a fact the checker cannot decide.",
      "type": ["object", "null"],
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "object",
            "required": ["id", "status", "summary", "details"],
            "properties": {
              "id": { "type": "string", "pattern": "^MS-(0[1-9]|1[0-3])$" },
              "status": { "enum": ["pass", "fail", "warn"] },
              "summary": { "type": "string", "minLength": 1 },
              "details": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "action": { "type": "string", "minLength": 1 },
              "repairs": {
                "description": "Additive repairs --apply writes for this check: only something that is missing and unambiguous, e.g. `app/v1/package.json: doplnit packageManager bun@1.4.2`. A lease is never moved and an existing declaration is never rewritten.",
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
