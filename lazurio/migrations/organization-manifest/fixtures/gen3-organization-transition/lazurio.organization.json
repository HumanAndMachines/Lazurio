{
  "schema_version": "lazurio.organization.v1",
  "kind": "organization",
  "organization": {
    "display_name": "Example Organization",
    "forge_binding": {
      "binding_state": "verified",
      "forge": "github",
      "locator": "Example-ai",
      "organization_id": "314957563"
    },
    "metadata": {},
    "slug": "Example-ai"
  },
  "root_repository": {
    "binding_state": "verified",
    "default_branch": "main",
    "forge": "github",
    "locator": "Example-ai/Example-ai_GEN3",
    "repository_id": "1276680840"
  },
  "manifests": {
    "modules": "modules.manifest.json"
  },
  "module_port_pool": {
    "end": 24299,
    "start": 24200
  },
  "governance": {
    "classification_reports": [
      {
        "issue": "issue-fixture-001",
        "label": "Fixture classification report",
        "path": "Example-ai/mission-control-data:v3:data/mission-control/reports/fixture.md"
      }
    ],
    "default_branch": "main",
    "file_ownership": {
      "derived": [
        "generated/**"
      ],
      "managed": [],
      "manual": [
        "AGENTS.md",
        "README.md",
        "company.gen3.json",
        "lazurio.organization.json",
        "modules.manifest.json",
        "manual/**",
        "workspace/**",
        "productionspace/**",
        "infra/**"
      ],
      "override": [
        "company/roles/**",
        "company/colleagues/**",
        "design-system/**",
        "guide/**"
      ]
    },
    "migration_policy": {
      "source_generation": "gen2",
      "source_repository": "Example-legacy/Example-legacy",
      "transition_marker_rule": "_GEN3 is a permanent repository generation marker.",
      "transition_repository": "Example-ai/Example-ai_GEN3",
      "write_policy": "Structural work happens in the GEN3 root."
    },
    "update_model": "standalone"
  },
  "teams": [
    {
      "default": true,
      "description": "Default fixture Team.",
      "display_name": "Delivery",
      "forge_binding": {
        "provider": "github",
        "schema_version": "lazurio.team-forge-binding.github.v0",
        "team": {
          "asserted_slug": "delivery",
          "id": "18910781"
        }
      },
      "slug": "delivery"
    },
    {
      "default": false,
      "description": "Second fixture Team.",
      "display_name": "Platform",
      "forge_binding": {
        "provider": "github",
        "schema_version": "lazurio.team-forge-binding.github.v0",
        "team": {
          "asserted_slug": "platform",
          "id": "18910782"
        }
      },
      "slug": "platform"
    }
  ],
  "layers": [
    {
      "kind": "company-shell",
      "ownership": "override",
      "path": "company"
    },
    {
      "kind": "workspace",
      "ownership": "manual",
      "path": "workspace"
    },
    {
      "kind": "design-system",
      "ownership": "override",
      "path": "design-system"
    },
    {
      "kind": "productionspace",
      "ownership": "manual",
      "path": "productionspace",
      "status": "active"
    },
    {
      "kind": "infra",
      "ownership": "manual",
      "path": "infra"
    },
    {
      "kind": "mission-control",
      "ownership": "manual",
      "path": "mission-control"
    },
    {
      "kind": "manual",
      "ownership": "manual",
      "path": "manual"
    }
  ],
  "task_sources": [
    {
      "authority": "source-of-truth",
      "kind": "todo-tasks-json",
      "path": "mission-control/db/data/mission-control/TODO.tasks.json",
      "slug": "mission-control-todo"
    },
    {
      "authority": "source-of-truth",
      "kind": "done-tasks-json",
      "path": "mission-control/db/data/mission-control/DONE.tasks.json",
      "slug": "mission-control-done"
    }
  ],
  "extensions": {
    "legacy": {
      "access_governance": {
        "admin_boundary": "Admins only.",
        "agent_rule": "Propose, do not apply.",
        "source_of_truth": "infra/access"
      },
      "business_context": {
        "customer_segments": [
          {
            "description": "Fixture customer segment.",
            "slug": "sme-management"
          }
        ],
        "decision_rules": [
          {
            "owner": "founder",
            "rule": "Escalate to the founder.",
            "trigger": "money or security impact"
          }
        ],
        "metrics": [
          {
            "description": "Fixture metric.",
            "slug": "accepted-proposals"
          }
        ],
        "revenue_drivers": [
          {
            "description": "Fixture revenue driver.",
            "priority": "high",
            "slug": "workspace-delivery"
          }
        ],
        "risks": [
          {
            "description": "Fixture risk.",
            "slug": "unclear-impact"
          }
        ],
        "value_propositions": [
          {
            "description": "Fixture value proposition.",
            "slug": "working-system"
          }
        ]
      },
      "colleague_overlays": {
        "agent_rule": "Personalspace never lands here.",
        "folder_name_rule": "<github-login>",
        "gitignored_local_paths": [
          "archive/",
          "private/",
          "scratch/"
        ],
        "path": "company/colleagues"
      },
      "generation_policy": {
        "application_versions": [
          {
            "purpose": "Current stable applications.",
            "version": "v3"
          }
        ],
        "data_versions": [
          {
            "namespace": "mission-control",
            "source_of_truth": "repository-db:v3"
          }
        ],
        "migration_rules": [
          {
            "rule": "Never rewrite published history."
          }
        ],
        "prototype_rule": "Prototype in v1, stabilize in v2."
      },
      "glossary_contract": {
        "agent_rule": "Do not guess terms.",
        "required_term_fields": [
          "term",
          "definition"
        ],
        "source": "GLOSSARY.md"
      },
      "source_of_truth_matrix": [
        {
          "domain": "plans",
          "note": "Fixture matrix row.",
          "source": "mission-control/db"
        }
      ],
      "template_sync_role": "consumer"
    }
  },
  "compatibility": {
    "legacy_projection": {
      "path": "company.gen3.json",
      "algorithm": "sha256-canonical-json-v1",
      "sha256": "sha256:290884c33c6f1f125f8038a6f95c9f45a5c6663045a66ec55c06f296df2156e7"
    }
  }
}
